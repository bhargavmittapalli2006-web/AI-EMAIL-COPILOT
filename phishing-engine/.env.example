# AI Email Copilot - Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=0.0.0.0

# Session Configuration
SESSION_SECRET_KEY=your_secure_random_session_secret_key_here

# Google OAuth 2.0 Configuration (OpenID Connect)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

